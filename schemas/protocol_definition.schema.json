{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DarcStar-Games/stationeers-ic10/schemas/protocol_definition.schema.json",
  "title": "Stationeers IC10 stack protocol definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "protocol_id", "name", "transport", "magic", "abi", "header_bases", "canonical_refs", "provider_interfaces", "consumer_interfaces"],
  "properties": {
    "$schema": {"const": "../../schemas/protocol_definition.schema.json"},
    "format": {"const": "IC10_PROTOCOL_DEFINITION_V1"},
    "protocol_id": {"type": "string", "pattern": "^ic10\\.stack\\.[0-9]+\\.abi[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "transport": {"const": "ic-housing-stack"},
    "magic": {"type": "integer", "minimum": 1},
    "abi": {"type": "integer", "minimum": 1},
    "header_bases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 510}},
    "canonical_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provider_interfaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/providerInterface"}},
    "consumer_interfaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/consumerInterface"}}
  },
  "$defs": {
    "cellArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 511}
    },
    "cellRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0, "maximum": 511},
        "end": {"type": "integer", "minimum": 0, "maximum": 511}
      }
    },
    "cellRanges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/cellRange"}},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["device-port", "network-reference"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "operator", "value"],
      "properties": {
        "address": {"type": "integer", "minimum": 0, "maximum": 511},
        "operator": {"enum": ["equals", "minimum", "maximum"]},
        "value": {"type": ["integer", "number", "string"]}
      }
    },
    "field": {
      "type": "object",
      "required": ["address", "name", "value_type", "semantic_source", "access"],
      "properties": {
        "address": {"type": "integer", "minimum": 0, "maximum": 511},
        "name": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["number", "integer", "enum", "hash", "reference-id", "boolean"]},
        "semantic_source": {"enum": ["unresolved", "source", "override", "protocol-header"]},
        "access": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["self-read", "self-write", "external-read", "external-write"]}},
        "const": {"type": ["integer", "number", "string"]},
        "default": {"type": ["integer", "number", "string"]},
        "enum_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/enumValue"}},
        "reserved": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "name"],
      "properties": {
        "value": {"type": ["integer", "number", "string"]},
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "providerInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "header_base", "readable_ranges", "writable_ranges", "fields", "behavior"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "header_base": {"type": "integer", "minimum": 0, "maximum": 510},
        "readable_ranges": {"$ref": "#/$defs/cellRanges"},
        "writable_ranges": {"$ref": "#/$defs/cellRanges"},
        "fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "behavior": {"$ref": "#/$defs/behavior"}
      }
    },
    "consumerInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "endpoint", "header_base", "literal_reads", "literal_writes", "dynamic_read_ranges", "dynamic_write_ranges", "dynamic_read_range_source", "dynamic_write_range_source", "constraints", "publication_requirements"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "endpoint": {"$ref": "#/$defs/endpoint"},
        "header_base": {"type": "integer", "minimum": 0, "maximum": 510},
        "literal_reads": {"$ref": "#/$defs/cellArray"},
        "literal_writes": {"$ref": "#/$defs/cellArray"},
        "dynamic_read_ranges": {"$ref": "#/$defs/cellRanges"},
        "dynamic_write_ranges": {"$ref": "#/$defs/cellRanges"},
        "dynamic_read_range_source": {"enum": ["none", "source-derived", "source-fingerprinted-exception"]},
        "dynamic_write_range_source": {"enum": ["none", "source-derived", "source-fingerprinted-exception"]},
        "constraints": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/constraint"}},
        "publication_requirements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/publicationRequirement"}}
      }
    },
    "publicationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "address"],
      "properties": {
        "kind": {"enum": ["commit-last", "seqlock"]},
        "address": {"type": "integer", "minimum": 0, "maximum": 511}
      }
    },
    "publicationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "address", "description", "source"],
      "properties": {
        "kind": {"enum": ["commit-last", "seqlock"]},
        "address": {"type": "integer", "minimum": 0, "maximum": 511},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["verified-inline-order", "source-fingerprinted-paired-sequence", "source-fingerprinted-declaration"]}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "address", "equals", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "kind": {"const": "cell-equals"},
        "address": {"type": "integer", "minimum": 0, "maximum": 511},
        "equals": {"type": ["integer", "number", "string"]},
        "source": {"enum": ["generated-protocol-header", "override"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_rules", "restart", "invariants"],
      "properties": {
        "publication_rules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/publicationRule"}},
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source"],
          "properties": {
            "mode": {"enum": ["cleared-on-init", "conditional-reset", "preserved-unless-overwritten"]},
            "source": {"const": "static-entry-path-analysis"}
          }
        },
        "invariants": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/invariant"}}
      }
    }
  }
}
