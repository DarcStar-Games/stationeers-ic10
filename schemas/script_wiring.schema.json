{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/DarcStar-Games/stationeers-ic10/schemas/script_wiring.schema.json",
 "title": "Stationeers IC10 canonical device-port wiring map",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "$schema",
  "format",
  "ports"
 ],
 "properties": {
  "$schema": {
   "const": "../schemas/script_wiring.schema.json"
  },
  "format": {
   "const": "IC10_SCRIPT_WIRING_V1"
  },
  "ports": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/scriptPorts"
   }
  }
 },
 "$defs": {
  "scriptPorts": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "d0": {"$ref": "#/$defs/portPeer"},
    "d1": {"$ref": "#/$defs/portPeer"},
    "d2": {"$ref": "#/$defs/portPeer"},
    "d3": {"$ref": "#/$defs/portPeer"},
    "d4": {"$ref": "#/$defs/portPeer"},
    "d5": {"$ref": "#/$defs/portPeer"}
   }
  },
  "portPeer": {
   "anyOf": [
    {"$ref": "#/$defs/scriptPeer"},
    {"$ref": "#/$defs/devicePeer"}
   ]
  },
  "scriptPeer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "providers",
    "note"
   ],
   "properties": {
    "kind": {"const": "script"},
    "providers": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^ic10/[a-z0-9-]+/[a-z0-9_]+\\.ic10$"
     }
    },
    "note": {"type": "string", "minLength": 1},
    "header_reads": {
     "type": "object",
     "additionalProperties": {"type": "string", "minLength": 1}
    }
   }
  },
  "devicePeer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "role"
   ],
   "properties": {
    "kind": {"const": "physical-device"},
    "role": {"type": "string", "minLength": 1},
    "note": {"type": "string", "minLength": 1}
   }
  }
 }
}
