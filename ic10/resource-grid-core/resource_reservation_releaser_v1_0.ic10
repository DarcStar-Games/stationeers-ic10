# Generic Reservation Releaser ABI1: d0 owner service; clears owner epoch only.
poke 0 HASH("ResourceReservationReleaser.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 9
get r0 db 10
beq r15 r0 Loop
bdns d0 Bad
get r13 db 8
blez r13 Bad
l r12 d0 ReferenceId
move r6 0
move r8 0
Scan:
get r1 db:0 r6
blt r1 0 Done
add r6 r6 1
getd r0 r1 0
bne r0 HASH("ResourceReservation.v1") Scan
getd r0 r1 17
bne r0 r12 Scan
getd r0 r1 18
bne r0 r13 Scan
putd r1 13 0
putd r1 14 0
putd r1 15 0
putd r1 16 0
putd r1 17 0
putd r1 18 0
putd r1 19 0
putd r1 25 -1
putd r1 26 0
putd r1 27 -1
add r8 r8 1
j Scan
Done:
poke 12 r8
move r0 1
j Reply
Bad:
move r0 -1
Reply:
poke 11 r0
poke 10 r15
j Loop
