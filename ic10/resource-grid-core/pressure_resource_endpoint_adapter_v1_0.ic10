# Pressure -> Generic Resource Endpoint ABI1. d0 PressureDomain Inventory ABI2.
poke 0 HASH("ResourceEndpoint.v1")
poke 1 1
poke 2 0
poke 52 1 # ResourceClass FLUID
poke 12 1 # Unit MOLE
poke 13 3 # exact export + exact import
poke 11 0
move r15 -1
Loop:
yield
bdns d0 Bad
get r14 d0 12
blez r14 Bad
beq r14 r15 Loop
get r0 d0 0
bne r0 HASH("PressureDomainInventory.v2") Bad
get r1 d0 14 # role
get r2 d0 15 # medium
get r3 d0 16 # exportable mol
get r4 d0 17 # import capacity mol
get r5 d0 11 # status
get r0 d0 12
bne r0 r14 Loop
move r6 0
beq r1 1 Low
beq r1 2 High
beq r1 3 Store
j Bad
Low:
move r6 1
j Publish
High:
move r6 2
j Publish
Store:
move r6 7
Publish:
l r7 d0 ReferenceId
poke 53 r2
poke 54 r6
poke 55 r3
poke 56 r4
poke 57 0 # rate unknown at endpoint layer
poke 8 r5
poke 9 r7
poke 10 r14
get r0 db 11
add r0 r0 1
poke 11 r0
move r15 r14
j Loop
Bad:
poke 55 0
poke 56 0
poke 57 0
poke 8 -1
get r0 db 11
add r0 r0 1
poke 11 r0
move r15 -1
j Loop
