# Recipe Execution Profile View ABI1: d0=any Recipe Store; request S10 RecipeHash.
poke 0 HASH("RecipeExecutionProfileView.v1")
poke 1 1
poke 2 0
poke 14 0
poke 15 0
Loop:
yield
get r10 db 10
beqz r10 Bad
bdns d0 Bad
l r2 d0 ReferenceId
get r12 d0 11
blez r12 Bad
getd r0 r12 0
bne r0 HASH("CatalogCoordinatorCore.v4") Bad
getd r15 r12 22
mod r0 r15 2
bnez r0 Loop
getd r11 r12 21
First:
getd r1 r2 21
blez r1 Store
move r2 r1
j First
Store:
getd r0 r2 0
bne r0 HASH("GenericCatalogStore.v6") Bad
getd r0 r2 3
bne r0 HASH("CatalogSchema.Recipe.v3") Bad
getd r14 r2 17
mod r0 r14 2
bnez r0 Loop
getd r7 r2 9
move r5 0
Scan:
bge r5 r7 StoreDone
mul r8 r5 2
add r8 r8 32
getd r9 r2 r8
getd r0 r2 r9
bne r0 r10 Next
add r8 r8 1
getd r8 r2 r8
blt r8 8 Bad
add r0 r9 4
getd r4 r2 r0
bltz r4 Bad
bgt r4 16 Bad
mul r0 r4 2
add r0 r0 5
bgt r0 r8 Bad
move r3 0
Clear:
bge r3 32 CopyHeader
add r0 r3 16
poke r0 0
add r3 r3 1
j Clear
CopyHeader:
poke 11 0
add r0 r9 1
getd r0 r2 r0
poke 11 r0
add r0 r9 2
getd r0 r2 r0
poke 12 r0
poke 13 r4
move r3 0
Inputs:
bge r3 r4 Publish
mul r0 r3 2
add r1 r0 5
add r1 r1 r9
getd r1 r2 r1
add r0 r0 16
poke r0 r1
add r1 r0 1
add r0 r9 r3
add r0 r0 r3
add r0 r0 6
getd r0 r2 r0
poke r1 r0
add r3 r3 1
j Inputs
Publish:
getd r0 r2 17
bne r0 r14 Loop
getd r0 r12 22
bne r0 r15 Loop
poke 48 r11
poke 49 r10
poke 15 1
poke 14 r14
j Loop
Next:
add r5 r5 1
j Scan
StoreDone:
getd r1 r2 24
blez r1 Missing
move r2 r1
j Store
Bad:
poke 49 r10
poke 15 -2
poke 14 0
j Loop
Missing:
poke 49 r10
getd r0 r12 22
bne r0 r15 Loop
poke 15 -3
poke 14 0
j Loop
