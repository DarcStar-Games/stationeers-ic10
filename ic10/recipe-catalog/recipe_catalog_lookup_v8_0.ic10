# Recipe Catalog Lookup v8: Store ABI5 dynamic item heap; d0=any Recipe Store.
# Request S12 Family,S13 Cap,S14 Ordinal,S15 Gen. Response S8..S11,S16 token.
poke 0 HASH("RecipeCatalogLookup.v3")
poke 1 3
poke 2 0
poke 16 0
Loop:
yield
get r15 db 15
get r0 db 16
beq r15 r0 Loop
get r3 db 12
get r4 db 13
get r5 db 14
bltz r5 BadRequest
bdns d0 CatalogBad
l r1 d0 ReferenceId
get r12 d0 11
blez r12 CatalogBad
getd r0 r12 0
bne r0 HASH("CatalogCoordinatorCore.v4") CatalogBad
getd r14 r12 22
mod r0 r14 2
bnez r0 CatalogBad
First:
getd r0 r1 21
blez r0 Start
move r1 r0
j First
Start:
move r7 0
move r8 0
move r9 0
Store:
getd r0 r1 0
bne r0 HASH("GenericCatalogStore.v6") CatalogBad
getd r0 r1 1
bne r0 6 CatalogBad
getd r0 r1 3
bne r0 HASH("CatalogSchema.Recipe.v3") CatalogBad
getd ra r1 17
mod r0 ra 2
bnez r0 Loop
getd r11 r1 9
add r7 r7 r11
getd r0 r1 23
bne r0 r3 StoreDone
move sp 0
Records:
bge sp r11 StoreDone
mul r0 sp 2
add r0 r0 32
getd r10 r1 r0
add r0 r10 1
getd r2 r1 r0
bne r2 r3 NextRec
add r0 r10 2
getd r2 r1 r0
bgt r2 r4 NextRec
add r8 r8 1
add r0 r10 3
getd r0 r1 r0
bne r0 r5 NextRec
bnez r9 CatalogBad
getd r0 r1 r10
poke 10 r0
poke 11 r2
move r9 1
NextRec:
add sp sp 1
getd r11 r1 9
j Records
StoreDone:
getd r0 r1 17
bne r0 ra Loop
getd r10 r1 24
blez r10 Finish
move r1 r10
j Store
Finish:
getd r0 r12 22
bne r0 r14 Loop
beqz r8 NotFound
bge r5 r8 NotFound
bnez r9 Found
j CatalogBad
Found:
poke 8 1
poke 9 r8
poke 16 r15
j Loop
BadRequest:
move r0 -1
j Fail
CatalogBad:
move r0 -2
j Fail
NotFound:
move r0 -3
Fail:
poke 8 r0
poke 9 r8
poke 10 0
poke 16 r15
j Loop
