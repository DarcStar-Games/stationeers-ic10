# Static POWER Resource Link ABI1; source d0, sink d1.
poke 0 HASH("ResourceLink.v1")
poke 1 1
poke 2 0
poke 30 4
poke 31 HASH("Power.Electrical")
poke 32 1
poke 13 1
Loop:
yield
bdns d0 Bad
bdns d1 Bad
get r14 d0 12
get r15 d1 12
blez r14 Bad
blez r15 Bad
get r0 d0 0
bne r0 HASH("ResourceReservation.v1") Bad
get r0 d1 0
bne r0 HASH("ResourceReservation.v1") Bad
get r0 d0 33
bne r0 4 Bad
get r0 d1 33
bne r0 4 Bad
l r1 d0 ReferenceId
l r2 d1 ReferenceId
get r3 db 20
max r3 r3 0
get r4 db 21
max r4 r4 0
get r0 d0 12
bne r0 r14 Loop
get r0 d1 12
bne r0 r15 Loop
poke 28 r1
poke 29 r2
poke 33 r3
poke 8 r4
poke 9 1
poke 10 0
poke 11 0
get r0 db 12
add r0 r0 1
poke 12 r0
j Loop
Bad:
poke 33 0
poke 9 -1
get r0 db 12
add r0 r0 1
poke 12 r0
j Loop
