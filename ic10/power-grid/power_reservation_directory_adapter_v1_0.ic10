# Power Reservation Directory Adapter ABI2: [DispatchKey,PolicyId,ReservationRef].
Boot:
clr db
poke 0 31415983
poke 1 2
poke 2 HASH("DirectorySchema.PowerReservation")
poke 3 1
poke 4 3
poke 5 64
poke 10 1
Loop:
yield
get r0 db 11
beqz r0 Start
poke 12 r0
j Loop
Start:
poke 12 0
get r15 db 8
add r15 r15 1
poke 8 r15
poke 9 0
move r7 0
move r8 0
Scan:
get r1 db:0 r7
blt r1 0 Publish
add r7 r7 1
getd r0 r1 0
bne r0 31415950 Scan
getd r0 r1 1
bne r0 1 Scan
getd r14 r1 12
blez r14 Scan
getd r0 r1 3
bne r0 4 Scan
getd r0 r1 17
beqz r0 OwnerOK
get r13 db 14
bne r0 r13 Scan
OwnerOK:
getd r2 r1 28
getd r3 r1 30
getd r4 r1 31
srl r5 r4 4
and r6 r4 15
beq r2 1 Producer
beq r2 2 Consumer
beq r2 3 Battery
j Scan
Producer:
getd r0 r1 5
blez r0 Scan
add r4 r5 1000000
jal Add
j Scan
Consumer:
and r0 r6 8
beqz r0 Scan
sub r4 999 r5
and r0 r6 1
bnez r0 Critical
and r0 r6 2
beqz r0 Scan
add r4 r4 4000000
jal Add
j Scan
Critical:
add r4 r4 3000000
jal Add
j Scan
Battery:
sub r4 999 r5
add r4 r4 2000000
jal Add
Charge:
sub r4 999 r5
add r4 r4 5000000
jal Add
j Scan
Add:
bge r8 64 Full
mul r0 r8 3
add r0 r0 16
poke r0 r4
add r0 r0 1
poke r0 r3
add r0 r0 1
poke r0 r1
add r8 r8 1
j ra
Full:
poke 9 1
j ra
Publish:
poke 6 r8
get r0 db 7
add r0 r0 1
poke 7 r0
get r0 db 8
add r0 r0 1
poke 8 r0
j Loop
