# Power dispatch cycle: PlanStore BEGIN -> sweep -> COMMIT.
poke 0 31416034
poke 1 1
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitBegin
beq r0 2 WaitSweep
beq r0 3 WaitCommit
get r15 db 2
get r0 db 3
beq r15 r0 Loop
poke 21 r15
put d0 12 1
put d0 10 r15
poke 20 1
j Loop
WaitBegin:
get r15 db 21
get r0 d0 11
bne r0 r15 Loop
get r0 d0 13
bne r0 1 Fail
put d1 2 r15
poke 20 2
j Loop
WaitSweep:
get r15 db 21
get r0 d1 3
bne r0 r15 Loop
get r0 d1 4
bne r0 1 Fail
put d0 12 3
put d0 10 r15
poke 20 3
j Loop
WaitCommit:
get r15 db 21
get r0 d0 11
bne r0 r15 Loop
get r0 d0 13
bne r0 1 Fail
get r0 d0 3
poke 5 r0
poke 4 1
j Reply
Fail:
poke 4 -1
Reply:
poke 3 r15
poke 20 0
j Loop
