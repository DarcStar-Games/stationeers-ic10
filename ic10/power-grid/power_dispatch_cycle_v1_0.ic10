# Power dispatch cycle: PlanStore BEGIN -> sweep -> COMMIT.
poke 0 HASH("PowerDispatchCycle.v1")
poke 1 1
poke 2 0
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitBegin
beq r0 2 WaitSweep
beq r0 3 WaitCommit
get r15 db 8
get r0 db 9
beq r15 r0 Loop
poke 21 r15
put d0 12 1
put d0 10 r15
poke 20 1
j Loop
WaitBegin:
get r15 db 21
get r0 d0 11
bne r0 r15 Loop
get r0 d0 13
bne r0 1 Fail
put d1 8 r15
poke 20 2
j Loop
WaitSweep:
get r15 db 21
get r0 d1 9
bne r0 r15 Loop
get r0 d1 10
bne r0 1 Fail
put d0 12 3
put d0 10 r15
poke 20 3
j Loop
WaitCommit:
get r15 db 21
get r0 d0 11
bne r0 r15 Loop
get r0 d0 13
bne r0 1 Fail
get r0 d0 28
poke 11 r0
poke 10 1
j Reply
Fail:
poke 10 -1
Reply:
poke 9 r15
poke 20 0
j Loop
