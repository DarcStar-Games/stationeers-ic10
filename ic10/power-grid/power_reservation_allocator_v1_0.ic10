# POWER allocator: validate -> commit -> release prior -> publish authority.
poke 0 31416037
poke 1 1
# Reflash revokes authority; preserve prior epoch S3 for cleanup.
poke 2 0
poke 4 0
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitV
beq r0 2 WaitC
beq r0 3 WaitR
beq r0 4 WaitCleanup
get r2 d0 3
blez r2 Loop
get r0 db 2
beq r0 r2 Loop
get r3 db 30
add r3 r3 1
poke 30 r3
poke 21 r2
put d1 2 r2
put d1 3 r3
poke 20 1
j Loop
WaitV:
get r3 db 30
get r0 d1 4
bne r0 r3 Loop
get r0 d1 5
bne r0 1 Fail
get r4 db 3
add r4 r4 1
poke 22 r4
get r0 db 21
put d2 2 r0
put d2 3 r4
put d2 4 r3
poke 20 2
j Loop
WaitC:
get r3 db 30
get r0 d2 5
bne r0 r3 Loop
get r0 d2 6
bne r0 1 CleanupNew
get r5 db 3
blez r5 Publish
put d3 8 r5
put d3 9 r3
poke 20 3
j Loop
WaitR:
get r3 db 30
get r0 d3 10
bne r0 r3 Loop
get r0 d3 11
bne r0 1 CleanupNew
j Publish
CleanupNew:
get r0 db 22
put d3 8 r0
get r3 db 30
put d3 9 r3
poke 20 4
j Loop
WaitCleanup:
get r3 db 30
get r0 d3 10
bne r0 r3 Loop
j Fail
Publish:
get r0 db 21
poke 2 r0
get r0 db 22
poke 3 r0
poke 4 1
poke 20 0
j Loop
Fail:
poke 4 -1
poke 20 0
j Loop
