# POWER allocator: validate -> commit -> release prior -> publish authority.
poke 0 31416037
poke 1 1
poke 2 0
# Reflash revokes authority; preserve prior epoch S3 for cleanup.
poke 8 0
poke 10 0
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitV
beq r0 2 WaitC
beq r0 3 WaitR
beq r0 4 WaitCleanup
get r2 d0 28
blez r2 Loop
get r0 db 8
beq r0 r2 Loop
get r3 db 30
add r3 r3 1
poke 30 r3
poke 21 r2
put d1 8 r2
put d1 9 r3
poke 20 1
j Loop
WaitV:
get r3 db 30
get r0 d1 10
bne r0 r3 Loop
get r0 d1 11
bne r0 1 Fail
get r4 db 9
add r4 r4 1
poke 22 r4
get r0 db 21
put d2 8 r0
put d2 9 r4
put d2 10 r3
poke 20 2
j Loop
WaitC:
get r3 db 30
get r0 d2 11
bne r0 r3 Loop
get r0 d2 12
bne r0 1 CleanupNew
get r5 db 9
blez r5 Publish
put d3 8 r5
put d3 9 r3
poke 20 3
j Loop
WaitR:
get r3 db 30
get r0 d3 10
bne r0 r3 Loop
get r0 d3 11
bne r0 1 CleanupNew
j Publish
CleanupNew:
get r0 db 22
put d3 8 r0
get r3 db 30
put d3 9 r3
poke 20 4
j Loop
WaitCleanup:
get r3 db 30
get r0 d3 10
bne r0 r3 Loop
j Fail
Publish:
get r0 db 21
poke 8 r0
get r0 db 22
poke 9 r0
poke 10 1
poke 20 0
j Loop
Fail:
poke 10 -1
poke 20 0
j Loop
