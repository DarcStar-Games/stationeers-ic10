# POWER consumer Endpoint ABI1. d0 load; config S16..21.
poke 0 HASH("ResourceEndpoint.v1")
poke 1 1
poke 2 0
poke 52 4
poke 53 HASH("Power.Electrical")
poke 54 2
poke 12 4
poke 13 2
poke 35 2
Loop:
yield
bdns d0 Bad
get r2 db 16
get r3 db 17
beqz r2 HaveDemand
bdnvl d0 r2 Bad
l r3 d0 r2
HaveDemand:
bnan r3 Bad
max r3 r3 0
get r4 db 50
beq r4 2 Shed
get r5 db 51
blez r5 PolicyDone
min r3 r3 r5
PolicyDone:
l r6 d0 ReferenceId
get r7 db 18
get r8 db 19
get r9 db 20
clamp r9 r9 0 999
get r10 db 21
and r10 r10 11
mul r9 r9 16
add r9 r9 r10
poke 55 0
poke 56 r3
poke 57 0
poke 8 1
poke 9 r6
poke 10 r4
poke 38 r7
poke 39 r8
poke 40 r9
get r0 db 11
add r0 r0 1
poke 11 r0
j Loop
Shed:
move r3 0
j PolicyDone
Bad:
poke 55 0
poke 56 0
poke 8 -1
get r0 db 11
add r0 r0 1
poke 11 r0
j Loop
