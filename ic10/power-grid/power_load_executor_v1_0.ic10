# Break-before-make managed POWER load/battery On executor. d0 PlanStore,d1 Allocator.
poke 0 HASH("PowerLoadExecutor.v1")
poke 1 1
poke 2 0
Loop:
yield
move r6 0
Scan:
get r1 db:0 r6
blt r1 0 Loop
add r6 r6 1
getd r0 r1 0
bne r0 HASH("ResourceReservation.v1") Scan
getd r0 r1 33
bne r0 4 Scan
getd r2 r1 28
beq r2 3 Managed
bne r2 2 Scan
getd r0 r1 31
and r0 r0 8
beqz r0 Scan
Managed:
getd r3 r1 32
getd r3 r3 9
blez r3 Scan
move r4 0
get r5 d1 10
bne r5 1 Set
get r7 d1 8
get r8 d1 9
blez r8 Set
get r0 d0 0
bne r0 HASH("PowerDispatchPlanStore.v1") Loop
get r9 d0 27
mod r0 r9 2
bnez r0 Set
get r0 d0 28
bne r0 r7 Set
get r10 d0 29
l r11 d1 ReferenceId
move r12 0
Find:
bge r12 r10 Stable
mul r0 r12 8
add r0 r0 32
add r5 r0 1
get r13 d0 r5
add r5 r5 1
get r14 d0 r5
beq r13 r1 Source
beq r14 r1 Sink
j Next
Source:
add r5 r0 5
get r15 d0 r5
j Authority
Sink:
add r5 r0 6
get r15 d0 r5
Authority:
getd r5 r1 17
bne r5 r11 Next
getd r5 r1 18
bne r5 r8 Next
getd r5 r1 19
bne r5 r15 Next
move r4 1
j Stable
Next:
add r12 r12 1
j Find
Stable:
get r0 d0 27
bne r0 r9 Off
Set:
# Turning ON requires authority to remain exact at the physical write boundary.
beqz r4 Write
get r0 d1 10
bne r0 1 Off
get r0 d1 8
bne r0 r7 Off
get r0 d1 9
bne r0 r8 Off
get r0 d0 27
bne r0 r9 Off
get r0 d0 28
bne r0 r7 Off
j Write
Off:
move r4 0
Write:
sd r3 On r4
j Scan
