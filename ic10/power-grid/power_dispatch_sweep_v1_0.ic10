# Sweep priority-ordered POWER sinks. d0 SinkSelector,d1 FlowBuilder,d2 PlanStore.
poke 0 31416033
poke 1 1
poke 2 0
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitSink
beq r0 2 WaitFlow
get r15 db 8
get r0 db 9
beq r15 r0 Loop
poke 21 r15
poke 22 0
poke 23 0
poke 24 0
j AskSink
AskSink:
get r0 db 22
put d0 12 r0
get r15 db 21
put d0 13 r15
poke 20 1
j Loop
WaitSink:
get r15 db 21
get r0 d0 14
bne r0 r15 Loop
get r0 d0 15
beq r0 -3 Done
bne r0 1 Fail
get r2 d0 16
get r3 d0 17
get r0 d0 8
poke 22 r0
get r4 d0 10
get r5 d0 11
get r0 d0 9
poke 25 r0
put d1 11 r2
put d1 12 r3
put d1 13 r4
put d1 14 r5
put d1 15 r15
poke 20 2
j Loop
WaitFlow:
get r15 db 21
get r0 d1 16
bne r0 r15 Loop
get r0 d1 8
bltz r0 Fail
bgtz r0 AskSink
get r3 d0 17
get r4 d0 10
blt r4 5000000 Shed
j AskSink
Shed:
get r0 db 23
add r0 r0 r3
poke 23 r0
blt r4 4000000 Critical
j AskSink
Critical:
poke 24 1
j AskSink
Done:
get r0 db 23
put d2 14 r0
get r0 db 24
put d2 15 r0
poke 10 1
j Reply
Fail:
poke 10 -1
Reply:
get r15 db 21
poke 9 r15
poke 20 0
j Loop
