# Validate one coherent POWER dispatch plan. d0 PlanStore.
poke 0 HASH("PowerPlanValidator.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 9
get r0 db 10
beq r15 r0 Loop
get r2 db 8
get r0 d0 0
