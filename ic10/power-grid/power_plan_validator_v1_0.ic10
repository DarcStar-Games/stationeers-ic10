add r5 r5 1
get r11 d0 r5
add r5 r5 1
get r12 d0 r5
add r5 r5 1
get r13 d0 r5
blez r9 Bad
blt r10 r9 Bad
getd r0 r7 0
bne r0 HASH("ResourceReservation.v1") Bad
getd r0 r8 0
bne r0 HASH("ResourceReservation.v1") Bad
getd r0 r7 33
bne r0 4 Bad
getd r0 r8 33
bne r0 4 Bad
getd r0 r7 9
blez r0 Bad
getd r0 r8 9
blez r0 Bad
getd r0 r7 12
bne r0 r11 Bad
getd r0 r8 12
bne r0 r12 Bad
getd r0 r6 0
