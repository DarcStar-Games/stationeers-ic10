# Build one POWER sink flow. d0 SourceSelector,d1 LinkSelector,d2 PlanStore.
poke 0 HASH("PowerSinkFlowBuilder.v1")
poke 1 1
poke 2 0
poke 20 0
Loop:
yield
get r0 db 20
beq r0 1 WaitSource
beq r0 2 WaitLink
beq r0 3 WaitStore
get r15 db 15
get r0 db 16
beq r15 r0 Loop
get r2 db 11
get r3 db 12
get r4 db 13
get r5 db 14
blez r2 Bad
blez r3 Bad
move r8 0
RequestSource:
put d0 11 r8
put d0 12 r15
poke 20 1
j Loop
WaitSource:
get r15 db 15
get r0 d0 13
bne r0 r15 Loop
get r0 d0 14
bne r0 1 None
get r9 d0 15
get r10 d0 16
get r8 d0 8
move r11 r3
beqz r5 NeedFull
min r11 r11 r10
j AskLink
NeedFull:
blt r10 r3 RequestSource
AskLink:
put d1 12 r9
put d1 13 r2
put d1 14 r11
put d1 15 r15
poke 20 2
j Loop
WaitLink:
get r15 db 15
get r0 d1 16
bne r0 r15 Loop
get r0 d1 17
bne r0 1 RequestSource
get r12 d1 8
get r13 d1 9
get r14 d1 10
get r10 d0 16
bgt r13 r10 RequestSource
get r1 d0 9
get r0 db 15
put d2 16 r12
put d2 17 r9
put d2 18 r2
put d2 19 r11
put d2 20 r13
put d2 21 r1
get r1 db 8
put d2 22 r1
put d2 23 r14
put d2 12 2
put d2 10 r0
poke 20 3
j Loop
WaitStore:
get r15 db 15
get r0 d2 11
bne r0 r15 Loop
get r0 d2 13
bne r0 1 Bad
poke 8 1
poke 9 r11
poke 10 r9
poke 16 r15
poke 20 0
j Loop
None:
poke 8 0
poke 9 0
poke 16 r15
poke 20 0
j Loop
Bad:
poke 8 -1
poke 9 0
poke 16 r15
poke 20 0
j Loop
