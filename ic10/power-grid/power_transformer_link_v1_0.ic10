# Transformer POWER Resource Link ABI1; transformer d0, reservations d1/d2.
poke 0 31415953
poke 1 1
poke 2 0
poke 30 4
poke 31 HASH("Power.Electrical")
poke 32 2
poke 13 3
Loop:
yield
bdns d0 Bad
bdns d1 Bad
bdns d2 Bad
get r14 d1 12
get r15 d2 12
blez r14 Bad
blez r15 Bad
get r0 d1 0
bne r0 31415950 Bad
get r0 d2 0
bne r0 31415950 Bad
get r0 d1 3
bne r0 4 Bad
get r0 d2 3
bne r0 4 Bad
l r1 d1 ReferenceId
l r2 d2 ReferenceId
l r3 d0 Maximum
get r4 db 20
blez r4 Native
min r3 r3 r4
Native:
max r3 r3 0
move r5 0
bdnvl d0 RequiredPower ReqReady
l r5 d0 RequiredPower
ReqReady:
max r5 r5 0
move r6 0
bdnvl d0 Error ErrReady
l r6 d0 Error
ErrReady:
bgtz r6 Bad
l r7 d0 ReferenceId
get r0 d1 12
bne r0 r14 Loop
get r0 d2 12
bne r0 r15 Loop
poke 28 r1
poke 29 r2
poke 33 r3
get r0 db 21
max r0 r0 0
poke 8 r0
poke 9 1
poke 10 r7
poke 11 0
poke 14 r5
get r0 db 12
add r0 r0 1
poke 12 r0
j Loop
Bad:
poke 33 0
poke 9 -1
get r0 db 12
add r0 r0 1
poke 12 r0
j Loop
