# Pressure Grid Link Directory Adapter v3.0: d1 Controller Directory; Adapter ABI2.
Boot:
clr db
poke 0 HASH("DirectoryAdapter.v3")
poke 1 3
poke 2 49
poke 3 HASH("DirectorySchema.PressureGridLink.v1")
poke 10 3
poke 11 64
poke 15 1
Loop:
yield
get r0 db 16
beqz r0 ScanStart
poke 17 r0
j Loop
ScanStart:
poke 17 0
get r15 db 13
add r15 r15 1
poke 13 r15
poke 14 0
move r8 0
bdns d1 Publish
get r0 d1 0
bne r0 HASH("GenericSnapshotDirectoryHost.v1") Publish
get r0 d1 9
bne r0 HASH("DirectorySchema.Controller.v1") Publish
get r0 d1 11
bne r0 2 Publish
get r6 d1 24
add r0 r6 29
get r0 d1 r0
bgtz r0 SourceOverflow
add sp r6 27
get r10 d1 sp
clamp r10 r10 0 64
move r7 0
Scan:
bge r7 r10 Publish
get r0 d1 11
bne r0 2 Publish
get sp d1 12
mul sp r0 sp
mul sp r6 sp
add sp sp 32
mul r0 r7 2
add sp sp r0
get r0 d1 sp
add sp sp 1
get r1 d1 sp
add r7 r7 1
bne r0 HASH("ControllerPressureTransfer") Scan
getd r15 r1 115
blez r15 Scan
getd r0 r1 97
bne r0 2 Scan
getd r2 r1 106
getd r3 r1 107
getd r0 r1 115
bne r0 r15 Scan
blez r2 Scan
blez r3 Scan
bge r8 64 Overflow
mul r4 r8 3
add r4 r4 18
poke r4 r1
add r4 r4 1
poke r4 r2
add r4 r4 1
poke r4 r3
add r8 r8 1
j Scan
Overflow:
poke 14 1
j Publish
SourceOverflow:
poke 14 1
move r8 0
Publish:
poke 12 r8
get r0 db 13
add r0 r0 1
poke 13 r0
get r0 db 7
add r0 r0 1
poke 7 r0
j Loop
