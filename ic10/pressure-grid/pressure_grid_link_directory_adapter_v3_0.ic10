# Pressure Grid Link Directory Adapter v3.0: d1 Controller Directory; Adapter ABI2.
Boot:
clr db
poke 0 31415983
poke 1 2
poke 2 HASH("DirectorySchema.PressureGridLink")
poke 3 1
poke 4 3
poke 5 64
poke 10 1
Loop:
yield
get r0 db 11
beqz r0 ScanStart
poke 12 r0
j Loop
ScanStart:
poke 12 0
get r15 db 8
add r15 r15 1
poke 8 r15
poke 9 0
move r8 0
bdns d1 Publish
get r0 d1 0
bne r0 31415981 Publish
get r0 d1 1
bne r0 1 Publish
get r0 d1 9
bne r0 HASH("DirectorySchema.Controller") Publish
get r0 d1 10
bne r0 1 Publish
get r0 d1 11
bne r0 2 Publish
get r6 d1 2
add r0 r6 7
get r0 d1 r0
bgtz r0 SourceOverflow
add sp r6 5
get r10 d1 sp
clamp r10 r10 0 64
move r7 0
Scan:
bge r7 r10 Publish
mul sp r6 128
add sp sp 32
mul r0 r7 2
add sp sp r0
get r0 d1 sp
add sp sp 1
get r1 d1 sp
add r7 r7 1
bne r0 HASH("ControllerPressureTransfer") Scan
getd r15 r1 115
blez r15 Scan
getd r0 r1 97
bne r0 2 Scan
getd r2 r1 106
getd r3 r1 107
getd r0 r1 115
bne r0 r15 Scan
blez r2 Scan
blez r3 Scan
bge r8 64 Overflow
mul r4 r8 3
add r4 r4 16
poke r4 r1
add r4 r4 1
poke r4 r2
add r4 r4 1
poke r4 r3
add r8 r8 1
j Scan
Overflow:
poke 9 1
j Publish
SourceOverflow:
poke 9 1
move r8 0
Publish:
poke 6 r8
get r0 db 7
add r0 r0 1
poke 7 r0
get r0 db 8
add r0 r0 1
poke 8 r0
j Loop
