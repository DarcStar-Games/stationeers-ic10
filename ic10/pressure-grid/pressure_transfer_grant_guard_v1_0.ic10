# Grant Guard v1.0: d0 Transfer ABI2,d1 Planner ABI2. One activation per commit epoch.
poke 0 31415948
poke 1 1
poke 2 0
poke 15 0
poke 16 -1
poke 18 0
poke 9 0
Loop:
yield
poke 18 0
bdns d0 Fault
get r14 d0 115
blez r14 Fault
get r0 d0 96
bne r0 27182818 Fault
get r0 d0 97
bne r0 2 Fault
get r0 d0 99
bne r0 HASH("ControllerPressureTransfer") Fault
l r1 d0 ReferenceId
get r2 d0 101
get r3 d0 102
get r4 d0 106
get r5 d0 107
get r6 d0 108
get r7 d0 109
get r8 d0 110
get r9 d0 111
get r10 d0 117
get r11 d0 118
get r12 d0 119
get r13 d0 120
get r0 d0 115
bne r0 r14 Loop
bdns d1 Fault
get r0 d1 0
bne r0 31415937 Fault
get r0 d1 1
bne r0 2 Fault
l r0 d1 ReferenceId
bne r8 r0 NoGrant
get r14 d1 14
blez r14 NoCommit
get r0 db 16
beq r0 r14 ActiveEpoch
bne r7 r14 Consume
blez r6 Consume
blez r9 Consume
bne r4 r10 Consume
bne r5 r11 Consume
bne r3 r12 Consume
bne r2 r13 Consume
poke 8 r6
poke 14 r9
poke 16 r14
poke 17 r1
poke 10 r10
poke 11 r11
poke 12 r12
poke 13 r13
j Active
ActiveEpoch:
get r0 db 10
bne r4 r0 Consume
get r0 db 11
bne r5 r0 Consume
get r0 db 12
bne r3 r0 Consume
get r0 db 13
bne r2 r0 Consume
Active:
get r0 db 14
blez r0 Spent
sub r0 r0 1
poke 14 r0
poke 15 1
j Publish
Spent:
poke 8 0
poke 14 0
poke 15 0
poke 17 r1
j Publish
Consume:
poke 16 r14
poke 8 0
poke 14 0
poke 15 0
poke 17 r1
j Publish
NoGrant:
# A staged grant for another planner must not disturb an already committed active epoch.
get r0 db 16
bdns d1 NoCommit
get r14 d1 14
beq r0 r14 ActiveEpoch
NoCommit:
poke 8 0
poke 14 0
poke 15 0
poke 17 r1
j Publish
Fault:
poke 8 0
poke 14 0
poke 15 -1
Publish:
get r0 db 9
add r0 r0 1
poke 9 r0
poke 18 r0
j Loop
