# Material Vending Inventory: d0 Vending,d1 Resource Profile View -> Endpoint ABI1.
poke 0 HASH("ResourceEndpoint.v1")
poke 1 1
poke 2 0
l r0 d1 ReferenceId
poke 14 r0
poke 35 HASH("StorageAccess.Vending")
poke 52 2 # ResourceClass ITEM
poke 54 7 # export + import + storage
poke 12 2 # Unit ITEM_QUANTITY
poke 13 3 # exact export + exact import
poke 11 0
move r15 0
Start:
yield
bdns d0 Bad
bdns d1 Bad
get r0 d1 0
bne r0 HASH("ResourceProfileView.v1") Bad
get r0 d1 1
bne r0 1 Bad
get r14 d1 29
blez r14 Bad
get r0 d1 28
blez r0 Bad
get r0 d1 8
bne r0 2 Bad
get r0 d1 10
bne r0 2 Bad
get r0 d1 11
bne r0 2 Bad
get r2 d1 9 # target item hash
get r3 d1 13 # max stack
blez r3 Bad
get r0 d1 29
bne r0 r14 Start
l r4 d0 Error
bgtz r4 Bad
l r5 d0 Power
blez r5 Bad
l r6 d0 ImportCount
l r7 d0 ExportCount
move r8 2 # internal slot 2..101
move r9 0 # available target quantity
move r10 0 # import capacity target quantity
move r11 -1
move r12 0
move r13 -1
Scan:
yield
ls r0 d0 r8 Occupied
beqz r0 Empty
ls r0 d0 r8 OccupantHash
bne r0 r2 Next
ls r0 d0 r8 Quantity
add r9 r9 r0
bgez r11 MatchKnown
move r11 r8
move r12 r0
MatchKnown:
ls r1 d0 r8 MaxQuantity
sub r1 r1 r0
max r1 r1 0
add r10 r10 r1
j Next
Empty:
add r10 r10 r3
bgez r13 Next
move r13 r8
Next:
add r8 r8 1
ble r8 101 Scan
l r0 d0 ImportCount
bne r0 r6 Start
l r0 d0 ExportCount
bne r0 r7 Start
get r0 d1 29
bne r0 r14 Start
l r1 d0 ReferenceId
get r0 db 37
sub r9 r9 r0
max r9 r9 0
get r0 db 36
and sp r0 9
select r9 sp 0 r9
and sp r0 10
select r10 sp 0 r10
poke 53 r2
poke 55 r9
poke 56 r10
poke 57 0 # chute throughput unknown here
poke 8 1
poke 9 r1
add r0 r6 r7
poke 10 r0
poke 38 r11
poke 39 r12
poke 40 r13
get r0 db 11
add r0 r0 1
poke 11 r0
move r15 r14
j Start
Bad:
poke 55 0
poke 56 0
poke 57 0
poke 8 -1
get r0 db 11
add r0 r0 1
poke 11 r0
move r15 0
j Start
