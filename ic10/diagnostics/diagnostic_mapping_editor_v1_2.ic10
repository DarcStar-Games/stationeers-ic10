# S8 ConsoleSel,S9 ControllerSel,S10 Renderer,S11 handled commit,S13 InputBridge.
alias consoleSelector r1
alias controllerSelector r2
alias renderer r3
alias input r4
alias display r5
alias controller r6
poke 0 17320510
poke 1 1
poke 2 0
Loop:
yield
get consoleSelector db 8
get controllerSelector db 9
get renderer db 10
move r10 17320509
move r11 17320508
move r12 16180339
move r7 1
ValidateService:
blez rr7 NoService
getd r0 rr7 0
add r8 r7 9
bne r0 rr8 NoService
getd r0 rr7 1
seq r8 r7 2
select r8 r8 2 1
bne r0 r8 NoService
add r7 r7 1
ble r7 3 ValidateService
get input db 13
blez input NoService
getd r0 input 0
bne r0 17320511 NoService
getd r0 input 1
bne r0 1 NoService
getd r0 input 10
bne r0 1 NotReady
getd r8 input 24
getd r0 controllerSelector 13
bne r0 r8 NotReady
getd r8 input 25
getd r0 consoleSelector 14
bne r0 r8 NotReady
getd r8 consoleSelector 10
getd r0 consoleSelector 11
bne r0 r8 NotReady
getd r0 consoleSelector 17
bne r0 1 NotReady
getd r0 controllerSelector 8
bne r0 1 NotReady
getd display consoleSelector 16
getd controller controllerSelector 5
blez display NotReady
blez controller NotReady
getd r8 input 23 # commit request generation survives transient selector unavailability
get r0 db 11
beq r8 r0 Ready
getd r13 input 19
getd r14 input 20
getd r15 input 21
getd r0 input 23
bne r0 r8 Loop
clamp r13 r13 1 16
clamp r14 r14 0 14
clamp r15 r15 0 11
getd r11 renderer 8
clamp r11 r11 0 64
move r7 0
FindRecord:
bge r7 r11 Append
mul r12 r7 5
add r12 r12 64
getd r0 renderer r12
beq r0 display WriteRecord
add r7 r7 1
j FindRecord
Append:
bge r11 64 Full
move r7 r11
WriteRecord:
mul r12 r7 5
add r12 r12 64
putd renderer r12 display
add r12 r12 1
putd renderer r12 controller
add r12 r12 1
putd renderer r12 r13
add r12 r12 1
putd renderer r12 r14
add r12 r12 1
putd renderer r12 r15
blt r7 r11 Committed
add r11 r11 1
putd renderer 8 r11 # append becomes visible only after record is complete
Committed:
bdnvs display On RequestNext
sd display On 1
RequestNext:
getd r0 consoleSelector 10
add r0 r0 1
putd consoleSelector 10 r0
poke 11 r8 # consume commit only after mapping + advance request are complete
poke 12 2
j Loop
Ready:
poke 12 1
j Loop
NoService:
move r0 -1
j Fault
NotReady:
move r0 -2
j Fault
Full:
poke 11 r8
move r0 -3
Fault:
poke 12 r0
s db Setting r0
j Loop
