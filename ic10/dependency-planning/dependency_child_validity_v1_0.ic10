# Validate live child identity and promised output. d0 Monitor,d1 RequirementView.
poke 0 HASH("DependencyChildValidity.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 15
get r0 db 16
beq r15 r0 Loop
get r2 db 13
get r3 db 14
blez r2 Bad
put d0 13 r2
put d0 14 r15
WaitM:
yield
get r0 d0 15
bne r0 r15 WaitM
get r0 d0 16
bne r0 1 Missing
get r6 d0 17
get r7 d0 18
get r8 d0 19
get r9 d0 20
get r10 d0 22
get r11 d0 23
poke 18 r6
poke 19 r10
poke 20 r11
poke 21 r7
poke 22 r8
put d1 15 r7
put d1 16 r8
put d1 17 r9
put d1 18 -1
put d1 19 r15
WaitR:
yield
get r0 d1 20
bne r0 r15 WaitR
get r0 d1 21
bne r0 1 Stale
get r12 d1 24
bne r12 r3 Stale
poke 23 r12
poke 17 1
poke 16 r15
j Loop
Missing:
move r0 -2
j Fail
Stale:
move r0 -3
j Fail
Bad:
move r0 -1
Fail:
poke 17 r0
poke 16 r15
j Loop
