# Normalize TRANSFORM/PRINT ITEM requirements.
poke 0 HASH("JobRequirementView.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 19
get r0 db 20
beq r15 r0 Loop
get r2 db 15
get r3 db 16
get r4 db 17
get r5 db 18
blez r4 Bad
beq r2 1 Transform
beq r2 2 Print
j Bad
Transform:
get r0 d0 0
bne r0 HASH("ResourceTransformProfileView.v4") Bad
put d0 70 r3
get r14 d0 74
get r0 d0 68
bne r0 r3 Loop
get r0 d0 69
bne r0 1 Bad
get r6 d0 71
get r7 d0 72
get r8 d0 33
get r9 d0 35
bltz r5 THead
bge r5 r7 Bad
mul r0 r5 4
add r0 r0 8
add r1 r0 1
get r10 d0 r1
add r1 r0 3
get r11 d0 r1
mul r11 r11 r4
j TCheck
THead:
move r10 0
move r11 0
TCheck:
get r0 d0 68
bne r0 r3 Loop
get r0 d0 69
bne r0 1 Loop
get r0 d0 74
bne r0 r14 Loop
j Publish
Print:
get r0 d1 0
bne r0 HASH("RecipeExecutionProfileView.v1") Bad
put d1 10 r3
get r14 d1 14
get r0 d1 49
bne r0 r3 Loop
get r0 d1 15
bne r0 1 Bad
get r6 d1 12
get r7 d1 13
bgt r7 16 Bad
move r8 r3
move r9 1
bltz r5 PHead
bge r5 r7 Bad
mul r0 r5 2
add r0 r0 16
get r10 d1 r0
add r0 r0 1
get r11 d1 r0
mul r11 r11 r4
put d2 8 r10
put d2 9 r15
WaitAlias:
yield
get r0 d2 10
bne r0 r15 WaitAlias
get r0 d2 11
bne r0 1 Bad
get r10 d2 12
j PCheck
PHead:
move r10 0
move r11 0
PCheck:
get r0 d1 14
bne r0 r14 Loop
Publish:
poke 22 r6
poke 23 r7
poke 24 r8
poke 25 r9
poke 26 r10
poke 27 r11
poke 21 1
poke 20 r15
j Loop
Bad:
poke 21 -1
poke 20 r15
j Loop
