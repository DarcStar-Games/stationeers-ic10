# Exact JobId monitor over coherent Generic Job Store.
poke 0 HASH("GenericJobMonitor.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 14
get r0 db 15
beq r15 r0 Loop
get r10 db 13
blez r10 Bad
get r0 d0 0
bne r0 HASH("GenericJobStore.v1") Bad
get r14 d0 16
and r0 r14 1
bnez r0 Loop
move r6 0
Find:
bge r6 32 Missing
mul r0 r6 8
add r1 r0 32
get r2 d0 r1
bne r2 r10 Next
add r1 r1 1
get r7 d0 r1
add r1 r1 1
get r8 d0 r1
add r1 r1 1
get r9 d0 r1
add r1 r1 3
get r11 d0 r1
mul r0 r6 7
add r1 r0 288
get r0 d0 r1
mul r0 r0 3
add r1 r1 r0
add r1 r1 1
get r12 d0 r1
add r1 r1 1
get r13 d0 r1
add r1 r1 1
get sp d0 r1
get r0 d0 16
bne r0 r14 Loop
poke 17 r6
poke 18 r7
poke 19 r9
poke 20 r11
poke 21 r12
poke 22 r13
poke 23 sp
poke 16 1
poke 15 r15
j Loop
Next:
add r6 r6 1
j Find
Missing:
move r0 -2
j Fail
Bad:
move r0 -1
Fail:
poke 16 r0
poke 15 r15
j Loop
