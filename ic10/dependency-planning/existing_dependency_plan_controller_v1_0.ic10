# Existing-plan decision + ref-aware cancel.
poke 0 HASH("ExistingDependencyPlanController.v1")
poke 1 1
poke 2 0
Loop:
yield
get r15 db 20
get r0 db 21
beq r15 r0 Loop
get r2 db 12
get r3 db 19
blez r2 Bad
put d0 12 1
put d0 13 r2
put d0 9 r15
WaitPlan:
yield
get r0 d0 10
bne r0 r15 WaitPlan
get r0 d0 11
beq r0 -2 Missing
bne r0 1 Bad
get r6 d0 33
get r7 d0 34
beq r3 1 Cleanup
get r0 db 15
put d1 20 r0
get r0 db 16
put d1 21 r0
get r0 db 17
put d1 22 r0
put d1 23 r6
put d1 24 r7
get r0 d0 36
put d1 25 r0
get r0 d0 37
put d1 26 r0
get r0 d0 38
put d1 27 r0
get r0 d0 39
put d1 28 r0
put d1 29 r15
WaitEval:
yield
get r0 d1 30
bne r0 r15 WaitEval
get r0 d1 31
beq r0 1 ClearReady
beq r0 2 NoAction
beq r0 3 NoAction
beq r0 4 NoAction
beq r0 5 Replan
beq r0 -3 Replan
beq r0 -4 ChildFail
j NoAction
Replan:
jal Release
move r0 5
move r1 1
j Reply
ChildFail:
move r0 -31
move r1 1
j Reply
ClearReady:
move r0 1
move r1 1
j Reply
Cleanup:
jal Release
move r0 1
move r1 1
j Reply
Missing:
select r0 r3 1 5
move r1 0
j Reply
NoAction:
move r1 0
j Reply
Bad:
move r0 -1
move r1 0
Reply:
poke 22 r0
poke 23 r1
poke 21 r15
j Loop
Release:
put d2 12 r2
put d2 13 r6
put d2 14 r7
put d2 15 r15
WaitRelease:
yield
get r0 d2 16
bne r0 r15 WaitRelease
get r0 d2 18
beqz r0 ReleaseDone
put d3 36 2
get r0 d2 19
put d3 37 r0
get r0 d2 20
put d3 38 r0
put d3 39 12
put d3 40 -20
put d3 32 r15
WaitCancel:
yield
get r0 d3 33
bne r0 r15 WaitCancel
ReleaseDone:
j ra
