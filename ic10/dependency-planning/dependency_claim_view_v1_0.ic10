add r5 r5 1
bge r5 512 Bad
poke 28 r5
put d1 13 r9
put d1 14 r2
mul r13 r15 512
add r13 r13 r5
put d1 15 r13
WaitC:
yield
get r0 d1 16
bne r0 r13 WaitC
get r0 d0 40
bne r0 r14 Loop
get r0 d1 17
bne r0 1 Unverified
get r12 d1 19
get r13 d1 18
beq r12 7 Next
bge r12 11 Next
get sp d1 23
move r7 128
move ra 0
move r4 0
CountLoop:
