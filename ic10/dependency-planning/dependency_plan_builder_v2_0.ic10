# Reuse active future-output claim or create one child. d0 ClaimView,d1 ChildCreator.
poke 0 HASH("DependencyPlanBuilder.v2")
poke 1 2
poke 2 0
Loop:
yield
get r15 db 30
get r0 db 31
beq r15 r0 Loop
get r2 db 19
get r8 db 25
blez r2 Bad
blez r8 Bad
put d0 15 r8
put d0 16 r2
put d0 17 0
put d0 18 r15
WaitC:
yield
get r0 d0 19
bne r0 r15 WaitC
get r0 d0 20
bne r0 1 New
get r1 d0 22
get sp d0 27
sub sp r1 sp
get r0 db 26
blt sp r0 New
j Shared
New:
put d1 14 r2
get r0 db 20
put d1 15 r0
get r0 db 21
put d1 16 r0
get r0 db 22
put d1 17 r0
get r0 db 23
put d1 18 r0
get r0 db 24
put d1 19 r0
put d1 20 r8
get r0 db 26
put d1 21 r0
put d1 22 r15
WaitN:
yield
get r0 d1 23
bne r0 r15 WaitN
get r0 d1 24
bne r0 1 ChildFail
get r0 d1 25
poke 33 r0
get r0 d1 27
poke 34 r0
poke 35 0
j Good
Shared:
get r0 d0 21
poke 33 r0
get r0 d0 22
poke 34 r0
poke 35 1
Good:
poke 32 1
poke 31 r15
j Loop
ChildFail:
poke 32 r0
poke 31 r15
j Loop
Bad:
poke 32 -1
poke 31 r15
j Loop
