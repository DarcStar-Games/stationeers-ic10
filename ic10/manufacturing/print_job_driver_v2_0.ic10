get r0 db 3
put d1 2 r0
poke 23 0
poke 24 0
poke 20 1
j Loop
Profile:
get r0 db 3
get r1 d1 41
bne r0 r1 Loop
get r1 d1 7
bne r1 1 Fault
get r0 db 5
get r1 d1 5
bne r0 r1 Fault
get r0 db 6
bne r0 1 Fault
get r1 d1 3
put d0 3 r1
Select:
get r0 db 30
add r0 r0 1
poke 30 r0
poke 21 r0
l r1 d3 ReferenceId
put d0 16 r1
put d0 2 HASH("DirectorySchema.PrinterExecution")
put d0 15 1
get r1 db 4
put d0 4 r1
put d0 5 2
get r1 db 23
put d0 6 r1
put d0 7 r0
poke 20 2
j Loop
SelectWait:
get r15 db 21
get r0 d0 8
bne r0 r15 Loop
get r0 d0 9
beq r0 1 Candidate
beq r0 -2 NoPrinter
j Fault
Candidate:
get r1 d0 10
get r0 d0 13
poke 23 r0
get r0 db 30
add r0 r0 1
poke 30 r0
poke 22 r0
put d2 2 r1
get r1 db 3
