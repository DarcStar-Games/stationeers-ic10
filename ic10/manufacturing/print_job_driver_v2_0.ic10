poke 0 HASH("PrintJobDriver.v2")
poke 1 2
poke 2 0
Loop:
yield
get r0 db 20
beq r0 1 Profile
beq r0 2 SelectWait
beq r0 3 ExecWait
get r15 db 8
get r0 db 9
beq r15 r0 Loop
poke 10 2
poke 11 0
poke 9 r15
get r0 db 13
put d1 10 r0
poke 23 0
poke 24 0
poke 20 1
j Loop
Profile:
get r0 db 13
get r1 d1 49
bne r0 r1 Loop
get r1 d1 15
bne r1 1 Fault
get r0 db 15
get r1 d1 13
bne r0 r1 Fault
get r0 db 16
bne r0 1 Fault
get r1 d1 11
put d0 18 r1
Select:
get r0 db 30
add r0 r0 1
poke 30 r0
poke 21 r0
l r1 d3 ReferenceId
put d0 16 r1
put d0 17 HASH("DirectorySchema.PrinterExecution.v1")
get r1 db 14
put d0 19 r1
put d0 20 2
get r1 db 23
put d0 21 r1
put d0 22 r0
poke 20 2
j Loop
SelectWait:
get r15 db 21
get r0 d0 8
bne r0 r15 Loop
get r0 d0 9
beq r0 1 Candidate
beq r0 -2 NoPrinter
j Fault
Candidate:
get r1 d0 10
get r0 d0 13
poke 23 r0
get r0 db 30
add r0 r0 1
poke 30 r0
poke 22 r0
put d2 14 r1
get r1 db 13
put d2 15 r1
get r1 db 14
put d2 16 r1
get r1 db 15
put d2 17 r1
get r1 db 16
put d2 18 r1
get r1 db 17
put d2 19 r1
put d2 8 r0
get r1 d0 12
put d2 13 r1
poke 20 3
j Loop
ExecWait:
get r15 db 22
get r1 d2 10
bne r1 r15 Loop
get r0 d2 11
bgt r0 2 Mirror
get r0 d2 9
beq r0 -2 Select
beq r0 -3 MarkRes
beq r0 -4 MarkCap
j Fault
Mirror:
poke 10 r0
get r1 d2 12
poke 11 r1
bge r0 7 Done
j Loop
MarkRes:
poke 24 3
j Select
MarkCap:
poke 24 4
j Select
NoPrinter:
get r0 db 24
seq r1 r0 3
seq r2 r0 4
sub r0 9 r1
add r0 r0 r2
poke 10 r0
poke 11 0
j Done
Fault:
poke 10 11
poke 11 -1
Done:
poke 20 0
j Loop
