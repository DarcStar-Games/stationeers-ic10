Boot:
clr db
poke 0 HASH("DirectoryAdapter.v3")
poke 1 3
poke 2 17
poke 3 HASH("DirectorySchema.PrinterExecution.v1")
poke 10 3
poke 11 64
poke 15 1
Loop:
yield
get r0 db 16
beqz r0 ScanStart
poke 17 r0
j Loop
ScanStart:
poke 17 0
get r0 d0 0
bne r0 HASH("GenericSnapshotDirectoryHost.v1") Loop
get r0 d0 9
bne r0 HASH("DirectorySchema.Printer.v2") Loop
get r0 d0 11
bne r0 3 Loop
get r11 d0 24
add r0 r11 25
get r10 d0 r0
add r0 r11 27
get r12 d0 r0
add r0 r11 29
get r0 d0 r0
bnez r0 Loop
mul r13 r11 192
add r13 r13 32
get r15 db 13
add r15 r15 1
poke 13 r15
poke 14 0
move r7 0
move r8 0
Bank:
get r1 db:0 r7
blt r1 0 VerifyRaw
add r7 r7 1
getd r0 r1 0
bne r0 HASH("PrinterExecutionBank.v2") Bank
getd r14 r1 8
mod r0 r14 2
bnez r0 ScanStart
move r6 0
Pin:
bge r6 6 VerifyBank
add r0 r6 16
getd r2 r1 r0
blez r2 NextPin
move r5 0
Find:
bge r5 r12 NextPin
mul r0 r5 3
add r0 r0 r13
get r3 d0 r0
bne r3 r2 FindNext
add r0 r0 1
get r3 d0 r0
add r0 r0 1
get r4 d0 r0
add r0 r6 24
getd r9 r1 r0
and r0 r9 2
mul r0 r0 256
or r4 r4 r0
and r0 r9 1
mul r0 r0 8192
or r4 r4 r0
and r0 r9 4
mul r0 r0 4096
or r4 r4 r0
sll r0 r6 16
or r4 r4 r0
bge r8 64 Overflow
mul r0 r8 3
add r0 r0 18
poke r0 r2
add r0 r0 1
poke r0 r3
add r0 r0 1
poke r0 r4
add r8 r8 1
j NextPin
FindNext:
add r5 r5 1
j Find
Overflow:
poke 14 1
NextPin:
add r6 r6 1
j Pin
VerifyBank:
getd r0 r1 8
bne r0 r14 ScanStart
j Bank
VerifyRaw:
get r0 d0 24
bne r0 r11 ScanStart
add r0 r11 25
get r0 d0 r0
bne r0 r10 ScanStart
poke 12 r8
get r0 db 13
add r0 r0 1
poke 13 r0
get r0 db 7
add r0 r0 1
poke 7 r0
j Loop
