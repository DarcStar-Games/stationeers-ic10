get r0 db 0
bne r0 HASH("PrinterExecutionBank.v2") Reset
get r0 db 1
beq r0 2 Init
Reset:
clr db
Init:
poke 0 HASH("PrinterExecutionBank.v2")
poke 1 2
poke 2 32
Loop:
yield
get r15 db 8
add r15 r15 1
poke 8 r15
move r7 0
move r8 0
Pins:
bge r7 6 Publish
move r1 0
move r2 1
move r3 0
bdns dr7 Request
l r1 dr7 ReferenceId
ls r2 dr7 1 Occupied
move r3 4
bnez r2 Occupied
j HaveDevice
Occupied:
move r3 5
HaveDevice:
add r0 r7 16
poke r0 r1
add r8 r8 1
Request:
add r4 r7 40
get r5 db r4
add r6 r7 56
get r10 db r6
beq r5 r10 MarkOwner
add r0 r7 32
get r11 db r0
bltz r5 Release
blez r1 Processor
bne r11 r1 Processor
add r0 r7 72
get r12 db r0
add r0 r7 64
get r13 db r0
beqz r12 CheckFree
bne r13 r1 Processor
bne r12 r5 Processor
j Success
CheckFree:
l r0 dr7 Power
beqz r0 Processor
l r0 dr7 Error
bnez r0 Processor
l r0 dr7 Activate
bnez r0 Processor
l r0 dr7 Lock
bnez r0 Processor
bnez r2 Capacity
s dr7 Lock 1
add r0 r7 64
poke r0 r1
add r0 r7 72
poke r0 r5
j Success
Release:
mul r0 r5 -1
add r4 r7 72
get r12 db r4
bne r0 r12 Processor
add r4 r7 64
get r13 db r4
bne r11 r13 Processor
beqz r12 Released
bne r1 r13 Released
s dr7 Lock 0
Released:
poke r4 0
add r4 r7 72
poke r4 0
j Success
Processor:
move r14 -2
j Respond
Capacity:
move r14 -4
j Respond
Success:
move r14 1
Respond:
add r0 r7 48
poke r0 r14
add r0 r7 56
poke r0 r5
MarkOwner:
blez r1 Pack
add r0 r7 64
get r13 db r0
add r0 r7 72
get r12 db r0
beqz r12 Pack
bne r13 r1 Pack
or r3 r3 2
Pack:
add r0 r7 24
poke r0 r3
add r7 r7 1
j Pins
Publish:
poke 10 r8
get r0 db 9
add r0 r0 1
poke 9 r0
get r0 db 8
add r0 r0 1
poke 8 r0
j Loop
