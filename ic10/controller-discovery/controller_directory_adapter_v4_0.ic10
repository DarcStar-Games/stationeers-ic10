# Controller Directory Adapter v4.0: publishes generic Adapter ABI2 candidates.
Boot:
clr db
poke 0 HASH("DirectoryAdapter.v3")
poke 1 3
poke 2 49
poke 3 HASH("DirectorySchema.Controller.v1")
poke 10 2
poke 11 64
poke 15 1
Loop:
yield
get r0 db 16
beqz r0 ScanStart
poke 17 r0
j Loop
ScanStart:
poke 17 0
get r15 db 13
add r15 r15 1
poke 13 r15
poke 14 0
move r7 0
move r8 0
Scan:
get r1 db:0 r7
blt r1 0 Publish
add r7 r7 1
ld r0 r1 PrefabHash
beq r0 -128473777 Probe
bne r0 2037291645 Scan
Probe:
getd r0 r1 96
bne r0 27182818 Scan
getd r0 r1 97
blt r0 1 Scan
bgt r0 2 Scan
bge r8 64 Overflow
mul r3 r8 2
add r3 r3 18
getd r0 r1 99
poke r3 r0
add r3 r3 1
poke r3 r1
add r8 r8 1
j Scan
Overflow:
poke 14 1
j Scan
Publish:
poke 12 r8
get r0 db 13
add r0 r0 1
poke 13 r0
get r0 db 7
add r0 r0 1
poke 7 r0
j Loop
