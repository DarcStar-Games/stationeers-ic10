# Config Input Bridge v1.0: Resolver logical control -> Editor physical image slot.
# S2 Editor RefId,S3 Generic Input Resolver RefId; no device screws.
alias editor r1
alias resolver r2
poke 0 22360681
poke 1 1
Loop:
yield
get editor db 2
blez editor Invalid
getd r0 editor 0
bne r0 22360680 Invalid
getd r0 editor 1
bne r0 1 Invalid
putd editor 25 0 # pessimistic; complete publication sets this LAST
getd r0 editor 15
beqz r0 Invalid
getd r6 editor 17 # active logical control count
blez r6 Invalid
getd r7 editor 27 # Loader-validated Profile, or zero
blez r7 ProfileReady
getd r0 r7 5
getd sp editor 29
bne r0 sp Invalid
ProfileReady:
get resolver db 3
blez resolver Invalid
getd r0 resolver 0
bne r0 31415931 Invalid
getd r0 resolver 1
bne r0 1 Invalid
putd resolver 9 r6
putd resolver 10 r7
getd r15 resolver 12 # resolved snapshot generation
getd r0 resolver 11
bne r0 1 Invalid
getd r9 resolver 13 # logical active-field ordinal
getd r10 resolver 14
getd r11 resolver 15
blez r9 Invalid
bgt r9 r6 Invalid
bnan r10 Invalid
getd r0 resolver 12
bne r0 r15 Loop
sub r0 r9 1
add r0 r0 64
getd r12 editor r0 # Loader map: logical ordinal -> stable physical slot
bltz r12 Invalid
bgt r12 31 Invalid
getd r13 editor 18 # Host snapshot binds value to loaded controller config
s db Setting r10
putd editor 20 r12
putd editor 21 r10
putd editor 22 r11
putd editor 26 r13
putd editor 25 1 # publication marker LAST
j Loop
Invalid:
move r0 nan
s db Setting r0
j Loop
