# Stack Cell Monitor ABI1: d0 target,d1 address (-1 reads S0 header),d2 optional out.
poke 0 31416052
poke 1 1
poke 2 0
poke 3 0
poke 4 0
poke 9 0
Loop:
yield
move r0 -1
move r1 0
move r2 0
move r4 -1
bdnvl d0 ReferenceId Publish
l r2 d0 ReferenceId
l r3 d0 PrefabHash
beq r3 HASH("StructureCircuitHousing") TargetReady
beq r3 HASH("StructureCircuitHousingCompact") TargetReady
move r4 -2
j Publish
TargetReady:
move r4 -3
bdnvl d1 Setting Publish
l r0 d1 Setting
beq r0 -1 Discover
move r4 -4
mod r3 r0 1
bnez r3 Publish
bltz r0 Publish
bgt r0 511 Publish
get r1 d0 r0
snan r4 r1
add r4 r4 1
j Publish
Discover:
move r4 -5
get r3 d0 0
mod r12 r3 1
bnez r12 Publish
beqz r3 Publish
move r4 -6
get r5 d0 1
mod r12 r5 1
bnez r12 Publish
blez r5 Publish
get r6 d0 2
get r7 d0 3
mod r12 r6 1
bnez r12 Publish
mod r12 r7 1
bnez r12 Publish
seq r12 r6 0
seq r13 r7 0
bne r12 r13 Publish
bltz r7 Publish
get r8 d0 4
mod r12 r8 1
bnez r12 Publish
beqz r8 HeaderReady
blt r8 5 Publish
bgt r8 508 Publish
get r12 d0 r8
bne r12 31416054 Publish
add r13 r8 1
get r12 d0 r13
bne r12 1 Publish
add r13 r8 2
get r12 d0 r13
mod r14 r12 1
bnez r14 Publish
blt r12 4 Publish
bgt r12 192 Publish
add r13 r8 3
get r15 d0 r13
beqz r15 ExtensionBound
bne r15 1 Publish
blt r12 5 Publish
add r13 r13 1
get r14 d0 r13
beqz r14 Publish
mod r14 r14 1
bnez r14 Publish
ExtensionBound:
add r13 r8 r12
bgt r13 512 Publish
HeaderReady:
move r1 r3
move r4 3
Publish:
poke 6 r0
poke 7 r1
poke 8 r2
poke 5 r4
get r3 db 9
add r3 r3 1
poke 9 r3 # complete sample generation publishes LAST
s db Setting r1
bdnvs d2 Setting Loop
s d2 Setting r1
j Loop
