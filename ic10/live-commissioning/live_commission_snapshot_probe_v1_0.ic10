add r1 r1 1
get r4 db r1
add r1 r1 1
get r5 db r1
add r1 r1 1
move r6 0
move r7 0
move r8 nan
move r9 0
beqz r3 Store
bdns dr0 Missing
l r7 dr0 ReferenceId
beq r3 1 Logic
beq r3 2 Stack
move r6 -2
j Store
Logic:
bdnvl dr0 r4 Unsupported
l r8 dr0 r4
bnan r8 Numeric
move r6 1
j Store
Stack:
