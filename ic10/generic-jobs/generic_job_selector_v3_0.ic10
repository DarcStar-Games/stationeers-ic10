poke 0 HASH("GenericJobSelector.v3")
poke 1 3
poke 2 0
Loop:
yield
get r15 db 20
get r0 db 21
beq r15 r0 Loop
get r0 d0 0
bne r0 HASH("GenericJobStore.v1") Bad
get r12 d0 16
and r0 r12 1
bnez r0 Loop
move r6 -1
move r8 0
move r13 0
Scan:
bge r13 32 Done
mul r0 r13 7
add r0 r0 288
get r1 d0 r0
mul r1 r1 3
add r1 r1 r0
add r1 r1 1
get r2 d0 r1
get r10 db 18
beqz r10 MState
beq r2 7 Next
bge r2 11 Next
j Eligible
MState:
beq r2 1 Eligible
blt r2 8 Next
bgt r2 10 Next
Eligible:
mul r3 r13 8
add r3 r3 32
get r4 d0 r3
get r0 db 19
blez r0 CursorOK
ble r4 r0 Next
CursorOK:
add r0 r3 1
get r5 d0 r0
beqz r10 MType
bne r5 r10 Next
j TypeOK
MType:
blt r5 1 Next
bgt r5 2 Next
TypeOK:
add r0 r3 7
get r14 d0 r0
bltz r6 Choose
bgt r14 r7 Choose
blt r14 r7 Next
bge r4 r8 Next
Choose:
move r6 r13
move r7 r14
move r8 r4
Next:
add r13 r13 1
j Scan
Done:
get r0 d0 16
bne r0 r12 Loop
and r0 r12 1
bnez r0 Loop
bltz r6 None
mul r3 r6 8
add r3 r3 32
mul r0 r6 7
add r0 r0 288
get r1 d0 r0
mul r1 r1 3
add r1 r1 r0
add r1 r1 1
get r2 d0 r1
add r1 r1 1
get r9 d0 r1
poke 23 r6
poke 24 r8
add r0 r3 1
get r1 d0 r0
poke 8 r1
add r0 r0 1
get r1 d0 r0
poke 9 r1
add r0 r0 1
get r1 d0 r0
poke 10 r1
add r0 r0 1
get r1 d0 r0
poke 11 r1
add r0 r0 1
get r1 d0 r0
poke 12 r1
add r0 r0 1
get r1 d0 r0
poke 13 r1
add r0 r0 1
get r1 d0 r0
poke 14 r1
poke 15 r2
poke 16 r9
poke 22 1
j Publish
None:
poke 22 -2
poke 23 -1
Publish:
get r0 d0 17
poke 17 r0
poke 21 r15
j Loop
Bad:
poke 22 -1
j Publish
