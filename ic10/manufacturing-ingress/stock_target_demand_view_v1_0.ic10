# Combine exact stock and unclaimed active output into one target decision.
poke 0 HASH("StockTargetDemandView.v1")
poke 1 1
poke 2 32
Loop:
yield
get r15 db 23
get r0 db 24
beq r15 r0 Loop
get r2 db 15
get r3 db 16
get r4 db 17
get r5 db 18
get r6 db 19
get r7 db 20
beqz r2 Bad
blez r3 Bad
bltz r4 Bad
ble r3 r4 Bad
blez r7 Bad
get r0 d0 0
bne r0 HASH("StockTargetInventoryView.v1") Bad
put d0 15 r2
put d0 16 r3
put d0 18 r15
WaitInventory:
yield
get r0 d0 19
bne r0 r15 WaitInventory
get r0 d0 20
beq r0 2 Ambiguous
bne r0 1 Bad
get r8 d0 21
bge r8 r3 NoNeed
get r0 d1 0
bne r0 HASH("StockTargetFutureView.v1") Bad
put d1 15 r2
put d1 16 r5
put d1 17 r6
put d1 18 r7
put d1 19 r15
WaitFuture:
yield
get r0 d1 20
bne r0 r15 WaitFuture
get r0 d1 21
bne r0 1 Bad
get r9 d1 22
get r10 d1 23
get r11 d1 24
sub r0 r3 r8
sub r0 r0 r9
ble r0 r4 NoNeed
div sp r0 r7
round r12 sp
slt r0 r12 sp
add r12 r12 r0
max r12 r12 1
poke 26 r12
poke 27 r8
poke 28 r9
poke 29 r10
poke 30 r11
move r13 1
j Reply
NoNeed:
move r13 2
j Reply
Ambiguous:
move r13 3
j Reply
Bad:
move r13 -1
Reply:
poke 25 r13
poke 24 r15
j Loop
