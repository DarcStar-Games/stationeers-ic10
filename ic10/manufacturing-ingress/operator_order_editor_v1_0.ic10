Boot:
get r0 db 0
bne r0 HASH("OperatorOrderEditor.v1") Init
get r0 db 1
beq r0 1 Loop
Init:
clr db
poke 0 HASH("OperatorOrderEditor.v1")
poke 1 1
poke 2 32
Loop:
yield
get r15 db 30
bgtz r15 Wait
move r0 0
bdnvl d2 Setting CommitState
l r0 d2 Setting
CommitState:
get r1 db 28
blez r0 Resolve
blez r1 Commit
Resolve:
poke 28 r0
get r0 d0 0
bne r0 HASH("GenericInputResolver.v1") Fault
put d0 9 4
put d0 10 0
get r15 d0 12
get r0 db 11
beq r15 r0 Loop
get r0 d0 11
bne r0 1 Fault
get r2 d0 13
get r3 d0 14
get r0 d0 12
bne r0 r15 Loop
poke 11 r15
beq r2 1 Family
beq r2 2 Ordinal
beq r2 3 Quantity
bne r2 4 Fault
round r0 r3
bne r0 r3 BadValue
poke 43 r0
move r4 8
j Staged
Family:
beqz r3 BadValue
round r0 r3
bne r0 r3 BadValue
poke 40 r0
move r4 1
j Staged
Ordinal:
bltz r3 BadValue
round r0 r3
bne r0 r3 BadValue
poke 41 r0
move r4 2
j Staged
Quantity:
blez r3 BadValue
round r0 r3
bne r0 r3 BadValue
poke 42 r0
move r4 4
Staged:
get r0 db 26
or r0 r0 r4
poke 26 r0
move r0 1
j Status
Commit:
get r0 db 26
bne r0 15 Incomplete
get r0 d1 0
bne r0 HASH("OperatorOrderJobIngress.v1") Fault
get r15 d1 20
add r15 r15 1
bgtz r15 Token
move r15 1
Token:
get r0 db 40
put d1 15 r0
get r0 db 41
put d1 16 r0
get r0 db 42
put d1 17 r0
get r0 db 43
put d1 18 r0
poke 30 r15
move r0 2
j Status
Wait:
get r0 d1 0
bne r0 HASH("OperatorOrderJobIngress.v1") Loop
poke 28 1
put d1 19 r15
get r0 d1 20
bne r0 r15 Loop
get r0 d1 21
get r1 d1 22
get r2 d1 23
poke 8 r0
poke 12 r1
poke 13 r2
poke 30 0
j Status
Incomplete:
move r0 -4
j Status
BadValue:
move r0 -2
j Status
Fault:
move r0 -1
Status:
poke 8 r0
s db Setting r0
j Loop
