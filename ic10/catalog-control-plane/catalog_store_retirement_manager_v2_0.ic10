# Catalog Store Retirement Manager v2.0: d0 Core,d1 Registry ABI3.
Boot:
poke 0 HASH("CatalogStoreRetirementManager.v1")
poke 1 1
poke 2 0
Loop:
yield
bdns d0 Loop
bdns d1 Loop
get r0 d0 0
bne r0 HASH("CatalogCoordinatorCore.v4") Loop
get r0 d1 0
bne r0 HASH("GenericRegistryDirectoryHost.v3") Loop
get r0 d1 3
bne r0 HASH("DirectorySchema.CatalogStoreNode.v1") Loop
get r11 d1 23
mod r0 r11 2
bnez r0 Loop
move r7 1
Scan:
bgt r7 64 Loop
mul r0 r7 6
add r0 r0 58
get r1 d1 r0
blez r1 Next
getd r0 r1 16
bne r0 3 Next
getd r0 r1 9
bgtz r0 Next
get r0 d1 23
bne r0 r11 Loop
get r0 d0 22
add r0 r0 1
put d0 22 r0
getd r2 r1 21
getd r3 r1 24
blez r2 NoPrev
putd r2 24 r3
NoPrev:
blez r3 NoNext
putd r3 21 r2
NoNext:
putd r1 16 5
get r0 d0 21
add r0 r0 1
put d0 21 r0
get r0 d0 22
add r0 r0 1
put d0 22 r0
j Loop
Next:
add r7 r7 1
j Scan
