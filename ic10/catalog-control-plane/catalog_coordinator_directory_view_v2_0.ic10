# Catalog Coordinator Directory View ABI2: d0 Registry ABI3,d1 Core; S2 NodeId.
poke 0 HASH("CatalogCoordinatorDirectoryView.v2")
poke 1 2
poke 2 0
Loop:
yield
bdns d0 Bad
bdns d1 Bad
get r0 d0 0
bne r0 HASH("GenericRegistryDirectoryHost.v3") Bad
get r0 d0 1
bne r0 3 Bad
get r0 d0 3
bne r0 HASH("DirectorySchema.CatalogStoreNode.v1") Bad
get r15 d0 23
mod r0 r15 2
bnez r0 Bad
get r0 d1 0
bne r0 HASH("CatalogCoordinatorCore.v4") Bad
get r2 db 12
blt r2 1 Bad
bgt r2 64 Bad
mul r3 r2 6
add r3 r3 58
move r4 13
Copy:
get r0 d0 r3
poke r4 r0
add r3 r3 1
add r4 r4 1
blt r4 19 Copy
get r0 d0 18
poke 11 r0
get r0 d1 16
poke 25 r0
get r0 d1 21
poke 26 r0
get r0 d1 15
poke 27 r0
get r0 d0 23
bne r0 r15 Bad
