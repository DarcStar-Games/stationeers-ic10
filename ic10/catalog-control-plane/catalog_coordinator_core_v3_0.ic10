# Catalog Coordinator Core v3.0: runtime Store claim/topology authority; d0 Directory.
Boot:
get r13 db 14
get r14 db 15
get r0 db 0
beq r0 HASH("CatalogCoordinatorCore.v4") Header
clr db
max r13 r13 1
max r14 r14 1
poke 14 r13
poke 15 r14
poke 18 1
poke 25 0
Header:
poke 0 HASH("CatalogCoordinatorCore.v4")
poke 1 4
poke 2 0
Loop:
yield
bdns d0 Loop
get r0 d0 0
bne r0 HASH("GenericRegistryDirectoryHost.v3") Loop
get r0 d0 1
bne r0 3 Loop
get r0 d0 3
bne r0 HASH("DirectorySchema.CatalogStoreNode.v1") Loop
l r12 d0 ReferenceId
poke 23 r12
get r0 d0 36
poke 8 r0
get r0 d0 44
poke 9 r0
get r0 d0 41
poke 10 r0
get r0 d0 39
poke 11 r0
get r0 d0 37
poke 12 r0
get r0 d0 38
poke 13 r0
get r0 db 25
blez r0 Publish
jal Claim
Publish:
get r0 db 16
add r0 r0 1
poke 16 r0
j Loop
Claim:
getd r15 r12 23
mod r0 r15 2
bnez r0 ra
move r7 1
Find:
bgt r7 64 ClaimFail
mul r0 r7 6
add r0 r0 58
add r2 r0 1
getd r6 r12 r2
bne r6 1 Next
getd r1 r12 r0
blez r1 Next
getd r6 r1 16
bne r6 1 Next
getd r0 r1 29
get r2 db 32
blt r0 r2 Next
j Do
Next:
add r7 r7 1
j Find
Do:
getd r0 r12 23
bne r0 r15 ra
get r0 db 22
add r0 r0 1
poke 22 r0
get r2 db 27
putd r1 3 r2
get r2 db 29
putd r1 13 r2
get r2 db 14
putd r1 14 r2
get r2 db 30
putd r1 21 r2
blez r2 LinkDone
putd r2 24 r1
LinkDone:
get r2 db 31
putd r1 8 r2
l r2 db ReferenceId
putd r1 11 r2
get r2 db 15
putd r1 12 r2
get r2 db 26
putd r1 23 r2
get r2 db 20
add r2 r2 1
poke 20 r2
putd r1 26 r2
putd r1 31 r2
putd r1 16 2
get r0 db 21
add r0 r0 1
poke 21 r0
get r0 db 22
add r0 r0 1
poke 22 r0
poke 17 r7
poke 25 0
j ra
ClaimFail:
poke 19 -1
j ra
