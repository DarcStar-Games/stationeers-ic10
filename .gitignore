# Python bytecode. build_release.py deletes these before packaging, and both the
# validation input fingerprint and the release inventory already skip them.
__pycache__/
*.pyc

# Release archives from `build_release.py --output <name>.zip`. The build excludes
# its own requested output from the manifest, but any earlier archive left in the
# tree would otherwise be packaged into the next one.
*.zip

# Generated and embedded inside release archives; never maintained in a checkout.
ARCHIVE_MANIFEST.sha256

# Local agent worktrees are tooling state, not framework inputs.
/.claude/worktrees/

# Local/CI validation output. Release builds regenerate these files and package
# them in the release ZIP, but they are not repository source.
/VALIDATION_SUMMARY.txt
/validation/FULL_VALIDATION_RUN.txt
/validation/VALIDATION_STATE.json
/validation/evidence/
